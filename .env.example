# ─────────────────────────────────────────────────────────────────────────────
# Fork & Founders — environment variables
# Copy to `.env` (local) or configure in your host's env settings (production).
# Everything is OPTIONAL: with no variables set the site builds and runs,
# integrations simply stay inert. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Leads / CRM ──────────────────────────────────────────────────────────────
# HTTPS endpoint that receives form submissions as JSON POST
# (Odoo webhook, Make/Zapier hook, or your own API route).
# Payload shape: see LeadPayload in src/lib/crm.ts
# When unset → leads are stored in browser localStorage under "ff_leads"
# with a reference like FF-ABC123 (frontend-only fallback, NOT real persistence).
VITE_LEAD_ENDPOINT=

# ── Analytics ────────────────────────────────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Events use the ff_* naming layer
# (src/lib/analytics.ts) and are pushed to window.dataLayer.
VITE_GA4_MEASUREMENT_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX (optional alternative to
# direct GA4). Analytics events only fire after analytics consent.
VITE_GTM_ID=

# ── Spam protection ──────────────────────────────────────────────────────────
# Cloudflare Turnstile site key (server-side secret stays in your backend/Odoo
# endpoint — NEVER put the secret here; this is the public site key only).
VITE_TURNSTILE_SITE_KEY=

# ── Marketing pixels (marketing-consent gated) ───────────────────────────────
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=

# ── Site chrome ──────────────────────────────────────────────────────────────
# Kill-switch for the announcement bar (the bar also has its own CMS-shaped
# config with start/end dates in src/components/layout/Chrome.tsx)
VITE_ANNOUNCEMENT_ENABLED=true
